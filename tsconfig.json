{
  "compilerOptions": {
    "target": "ES2017",
    "lib": ["dom", "dom.iterable", "esnext"],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": false,
    "noEmit": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "jsx": "preserve",
    "baseUrl": ".",
    "paths": {
      "@/*": ["./restaurant/src/*", "./customer/src/*", "./super-admin/src/*"]
    }
  },
  "include": [
    "restaurant/src/**/*",
    "customer/src/**/*",
    "super-admin/src/**/*"
  ],
  "exclude": ["node_modules", "backend"]
}
