datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

model Restaurant {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(150)
  phone     String   @unique @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  address   String?  @db.Text
  logoUrl   String?  @map("logo_url") @db.VarChar(500)
  firstMonthPromoUsed Boolean @default(false) @map("first_month_promo_used")
  createdAt DateTime @default(now()) @map("created_at")

  users      User[]
  tables     Table[]
  categories Category[]
  menuItems  MenuItem[]
  inventory  Inventory[]
  inventoryTransactions InventoryTransaction[]
  menuItemAddons        MenuItemAddon[]
  orders     Order[]
  expenses   Expense[]
  settings   RestaurantSetting?
  subscription RestaurantSubscription?
  saasSubscription Subscription?
  usageMetrics UsageMetric[]

  @@map("restaurants")
}

enum Role {
  owner
  waiter
  kitchen
  other
}

enum UserStatus {
  active
  inactive
}

model User {
  id           Int        @id @default(autoincrement())
  restaurantId Int        @map("restaurant_id")
  name         String     @db.VarChar(100)
  role         Role
  // loginId: 10-digit unique auto-generated staff login identifier (replaces phone)
  // For owner accounts, loginId is set to their email address
  loginId      String     @unique @map("login_id") @db.VarChar(255)
  phone        String?    @db.VarChar(50)
  passwordHash String     @map("password_hash") @db.VarChar(255)
  pinHash      String     @map("pin_hash") @db.VarChar(255)
  status       UserStatus @default(active)
  
  createdAt    DateTime   @default(now()) @map("created_at")

  // Password Reset Fields
  resetToken   String?    @map("reset_token") @db.VarChar(255)
  resetExpires DateTime?  @map("reset_expires")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]

  @@map("users")
}

model OtpVerification {
  id        Int      @id @default(autoincrement())
  email     String   @unique @db.VarChar(100)
  otp       String   @db.VarChar(6)
  payload   String   @db.Text // JSON string of name, restaurantName, phone, passwordHash
  createdAt DateTime @default(now()) @map("created_at")

  @@map("otp_verifications")
}

enum TableStatus {
  free
  occupied
  reserved
}

model Table {
  id           Int         @id @default(autoincrement())
  restaurantId Int         @map("restaurant_id")
  tableNo      String      @map("table_no") @db.VarChar(50)
  qrCode       String?     @map("qr_code") @db.VarChar(255)
  status       TableStatus @default(free)
  capacity     Int?        @default(4)
  floor        String?     @default("Ground Floor") @db.VarChar(100)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  orders     Order[]
  sessions   TableSession[]

  @@map("tables")
}

model Category {
  id           Int    @id @default(autoincrement())
  restaurantId Int    @map("restaurant_id")
  name         String @db.VarChar(100)

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItems  MenuItem[]

  @@map("categories")
}

enum StockTrackingMode {
  dont_track
  item_stock
  recipe_bom
}

enum RecipeScope {
  base_item
  variant
  addon
}

enum UnitDimension {
  weight
  volume
  count
}

enum InventoryTxType {
  purchase
  recipe_consumption
  wastage
  stock_adjustment
  cancellation_return
}

model MenuItem {
  id           Int               @id @default(autoincrement())
  restaurantId Int               @map("restaurant_id")
  categoryId   Int               @map("category_id")
  name         String            @db.VarChar(150)
  description  String?           @db.VarChar(500)
  price        Decimal           @db.Decimal(10, 2)
  costPrice    Decimal           @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  isVeg        Boolean           @default(false) @map("is_veg")
  stockMode    StockTrackingMode @default(dont_track) @map("stock_mode")
  stockQty     Int               @default(999) @map("stock_qty")
  lowStockAlert Int              @default(5) @map("low_stock_alert")
  hasVariants  Boolean           @default(false) @map("has_variants")
  allowSpice   Boolean           @default(true) @map("allow_spice")
  isAvailable  Boolean           @default(true) @map("is_available")
  trackStock   Boolean           @default(true) @map("track_stock")
  imageUrl     String?           @map("image_url") @db.VarChar(500)
  isArchived   Boolean           @default(false) @map("is_archived")
  createdAt    DateTime          @default(now()) @map("created_at")
  updatedAt    DateTime          @default(now()) @updatedAt @map("updated_at")

  restaurant   Restaurant        @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  category     Category          @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  variants     MenuItemVariant[]
  addons       MenuItemAddon[]
  recipes      Recipe[]
  orderItems   OrderItem[]
  kitchenTicketItems KitchenTicketItem[]

  @@map("menu_items")
}

model MenuItemVariant {
  id         Int        @id @default(autoincrement())
  menuItemId Int        @map("menu_item_id")
  name       String     @db.VarChar(100)
  price      Decimal    @db.Decimal(10, 2)
  isDefault  Boolean    @default(false) @map("is_default")
  isArchived Boolean    @default(false) @map("is_archived")

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipes    Recipe[]

  @@map("menu_item_variants")
}

model MenuItemAddon {
  id           Int        @id @default(autoincrement())
  menuItemId   Int?       @map("menu_item_id")
  restaurantId Int        @map("restaurant_id")
  name         String     @db.VarChar(100)
  price        Decimal    @db.Decimal(10, 2)
  isArchived   Boolean    @default(false) @map("is_archived")

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  menuItem     MenuItem?  @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  recipes      Recipe[]

  @@map("menu_item_addons")
}

model Inventory {
  id            Int                    @id @default(autoincrement())
  restaurantId  Int                    @map("restaurant_id")
  itemName      String                 @map("item_name") @db.VarChar(150)
  currentStock  Decimal                @default(0.000) @map("current_stock") @db.Decimal(10, 3)
  reservedStock Decimal                @default(0.000) @map("reserved_stock") @db.Decimal(10, 3)
  baseUnit      String                 @default("kg") @map("base_unit") @db.VarChar(20)
  unitDimension UnitDimension          @default(weight) @map("unit_dimension")
  reorderLevel  Decimal                @default(5.000) @map("reorder_level") @db.Decimal(10, 3)
  minAlertQty   Decimal                @default(2.000) @map("min_alert_qty") @db.Decimal(10, 3)
  costPerUnit   Decimal                @default(0.00) @map("cost_per_unit") @db.Decimal(10, 2)
  isArchived    Boolean                @default(false) @map("is_archived")

  restaurant    Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  recipes       Recipe[]
  transactions  InventoryTransaction[]

  @@map("inventory")
}

model InventoryTransaction {
  id             Int             @id @default(autoincrement())
  restaurantId   Int             @map("restaurant_id")
  inventoryId    Int             @map("inventory_id")
  txType         InventoryTxType @map("tx_type")
  qtyDelta       Decimal         @map("qty_delta") @db.Decimal(10, 3)
  balanceAfter   Decimal         @map("balance_after") @db.Decimal(10, 3)
  costAtTx       Decimal         @default(0.00) @map("cost_at_tx") @db.Decimal(10, 2)
  idempotencyKey String          @unique @map("idempotency_key") @db.VarChar(200)
  sourceType     String?         @map("source_type") @db.VarChar(50)
  sourceId       Int?            @map("source_id")
  note           String?         @db.VarChar(255)
  createdAt      DateTime        @default(now()) @map("created_at")

  restaurant     Restaurant      @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  inventory      Inventory       @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@map("inventory_transactions")
}

model Recipe {
  id           Int              @id @default(autoincrement())
  restaurantId Int              @map("restaurant_id")
  scope        RecipeScope      @default(base_item)
  menuItemId   Int?             @map("menu_item_id")
  variantId    Int?             @map("variant_id")
  addonId      Int?             @map("addon_id")
  inventoryId  Int              @map("inventory_id")
  qtyRequired  Decimal          @map("qty_required") @db.Decimal(10, 3)
  unit         String           @default("g") @db.VarChar(20)
  yieldPercent Decimal          @default(100.00) @map("yield_percent") @db.Decimal(5, 2)

  menuItem     MenuItem?        @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  variant      MenuItemVariant? @relation(fields: [variantId], references: [id], onDelete: Cascade)
  addon        MenuItemAddon?   @relation(fields: [addonId], references: [id], onDelete: Cascade)
  inventory    Inventory        @relation(fields: [inventoryId], references: [id], onDelete: Restrict)

  @@map("recipes")
}

enum OrderStatus {
  pending
  cooking
  ready
  completed
}

enum PaymentStatus {
  unpaid
  paid
}

enum PaymentMethod {
  cash
  upi
  card
}

enum OrderType {
  dine_in
  takeaway
  delivery
}

model Order {
  id              Int           @id @default(autoincrement())
  restaurantId    Int           @map("restaurant_id")
  tableId         Int?          @map("table_id")
  createdBy       Int           @map("created_by")
  orderType       OrderType     @default(dine_in) @map("order_type")
  subtotal        Decimal       @default(0.00) @db.Decimal(10, 2)
  discountApplied Decimal       @default(0.00) @map("discount_applied") @db.Decimal(10, 2)
  totalAmount     Decimal       @map("total_amount") @db.Decimal(10, 2)
  totalCost       Decimal       @default(0.00) @map("total_cost") @db.Decimal(10, 2)
  totalProfit     Decimal       @default(0.00) @map("total_profit") @db.Decimal(10, 2)
  status          OrderStatus   @default(pending)
  paymentStatus   PaymentStatus @default(unpaid) @map("payment_status")
  paymentMethod   PaymentMethod? @map("payment_method")
  approvedBy      String?       @map("approved_by") @db.VarChar(100)
  createdAt       DateTime      @default(now()) @map("created_at")
  receiptNo       String?       @unique @map("receipt_no") @db.VarChar(100)
  printCount      Int           @default(0) @map("print_count")
  isMerged        Boolean       @default(false) @map("is_merged")
  mergedIntoId    Int?          @map("merged_into_id")
  parentOrderId   Int?          @map("parent_order_id")

  restaurant Restaurant  @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  table      Table?      @relation(fields: [tableId], references: [id], onDelete: SetNull)
  creator    User        @relation(fields: [createdBy], references: [id], onDelete: Restrict)
  orderItems OrderItem[]
  logs            OrderLog[]
  payments        Payment[]
  kitchenTickets  KitchenTicket[]
  discountRecord  Discount?

  @@map("orders")
}

enum InventoryMode {
  disabled
  basic_stock
  full_inventory
}

enum StockDeductionTrigger {
  on_kot_sent
  on_order_completed
}

enum NegativeStockPolicy {
  block_sale
  allow_with_warning
  allow_silent
}

model OrderItem {
  id              Int      @id @default(autoincrement())
  orderId         Int      @map("order_id")
  menuItemId      Int      @map("menu_item_id")
  variantId       Int?     @map("variant_id")
  nameSnapshot    String   @default("") @map("name_snapshot") @db.VarChar(150)
  variantSnapshot String?  @map("variant_snapshot") @db.VarChar(100)
  addonsSnapshot  Json?    @map("addons_snapshot")
  spiceLevel      String?  @map("spice_level") @db.VarChar(50)
  qty             Int
  price           Decimal  @db.Decimal(10, 2)
  costPrice       Decimal  @default(0.00) @map("cost_price") @db.Decimal(10, 2)
  note            String?  @db.VarChar(255)

  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem        MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Restrict)

  @@map("order_items")
}

model Expense {
  id           Int      @id @default(autoincrement())
  restaurantId Int      @map("restaurant_id")
  title        String   @db.VarChar(255)
  category     String   @db.VarChar(100)
  amount       Decimal  @db.Decimal(10, 2)
  date         DateTime @default(now())
  createdAt    DateTime @default(now()) @map("created_at")

  restaurant Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("expenses")
}

model RestaurantSetting {
  id                    Int                   @id @default(autoincrement())
  restaurantId          Int                   @unique @map("restaurant_id")
  qrOrderingEnabled     Boolean               @default(true) @map("qr_ordering_enabled")
  customerTheme         String                @default("sunset") @map("customer_theme") @db.VarChar(50)
  sidebarTheme          String                @default("light") @map("sidebar_theme") @db.VarChar(50)
  sidebarQuickActions   Boolean               @default(true) @map("sidebar_quick_actions")
  sidebarStoreSwitch    Boolean               @default(true) @map("sidebar_store_switch")
  sidebarCollapsible    Boolean               @default(true) @map("sidebar_collapsible")
  sidebarHiddenItems    String[]              @default([]) @map("sidebar_hidden_items")

  inventoryMode         InventoryMode         @default(full_inventory) @map("inventory_mode")
  deductionTrigger      StockDeductionTrigger @default(on_kot_sent) @map("deduction_trigger")
  negativeStockPolicy   NegativeStockPolicy   @default(block_sale) @map("negative_stock_policy")
  lowStockAlertEnabled  Boolean               @default(true) @map("low_stock_alert_enabled")
  autoOutOfStockEnabled Boolean               @default(true) @map("auto_out_of_stock_enabled")

  vexoAiEnabled         Boolean               @default(true) @map("vexo_ai_enabled")
  vexoAiNormalLimit     Int                   @default(15) @map("vexo_ai_normal_limit")
  vexoAiApiLimit        Int                   @default(5) @map("vexo_ai_api_limit")

  subscriptionPlan      String                @default("trial") @map("subscription_plan") @db.VarChar(50)
  subscriptionStatus    String                @default("active") @map("subscription_status") @db.VarChar(50)
  trialEndsAt           DateTime?             @map("trial_ends_at")

  enabledFeatures       Json?                 @map("enabled_features")
  customPrice           Decimal               @default(0.00) @map("custom_price") @db.Decimal(10, 2)
  customNotes           String?               @map("custom_notes") @db.Text

  restaurant            Restaurant            @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@map("restaurant_settings")
}

model DemoRequest {
  id             Int      @id @default(autoincrement())
  name           String   @db.VarChar(100)
  email          String   @db.VarChar(100)
  phone          String   @db.VarChar(20)
  restaurantName String   @map("restaurant_name") @db.VarChar(150)
  message        String?  @db.Text
  status         String   @default("pending") @db.VarChar(30)
  adminNote      String?  @map("admin_note") @db.Text
  createdAt      DateTime @default(now()) @map("created_at")

  @@map("demo_requests")
}

model OrderLog {
  id         Int      @id @default(autoincrement())
  orderId    Int      @map("order_id")
  action     String   @db.VarChar(100) // "created", "status_change", "discount", "table_move", "split", "merge", etc.
  oldValue   String?  @db.Text
  newValue   String?  @db.Text
  userId     Int?     @map("user_id")
  deviceId   String?  @map("device_id") @db.VarChar(255)
  createdAt  DateTime @default(now()) @map("created_at")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  
  @@map("order_logs")
}

model Payment {
  id            Int           @id @default(autoincrement())
  orderId       Int           @map("order_id")
  method        PaymentMethod
  amount        Decimal       @db.Decimal(10, 2)
  status        String        @default("completed") @db.VarChar(50) // "completed", "refunded", etc.
  transactionId String?       @map("transaction_id") @db.VarChar(255)
  createdAt     DateTime      @default(now()) @map("created_at")

  order         Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model KitchenTicket {
  id        Int      @id @default(autoincrement())
  orderId   Int      @map("order_id")
  ticketNo  String   @map("ticket_no") @db.VarChar(50) // e.g. "KOT-1", "KOT-2"
  status    String   @default("pending") @db.VarChar(50) // "pending", "cooking", "ready"
  printedAt DateTime? @map("printed_at")
  createdAt DateTime @default(now()) @map("created_at")
  
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  items     KitchenTicketItem[]

  @@map("kitchen_tickets")
}

model KitchenTicketItem {
  id             Int           @id @default(autoincrement())
  kitchenTicketId Int          @map("kitchen_ticket_id")
  menuItemId     Int           @map("menu_item_id")
  qty            Int

  kitchenTicket  KitchenTicket @relation(fields: [kitchenTicketId], references: [id], onDelete: Cascade)
  menuItem       MenuItem      @relation(fields: [menuItemId], references: [id], onDelete: Cascade)

  @@map("kitchen_ticket_items")
}

model Discount {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique @map("order_id")
  percentage Decimal  @db.Decimal(5, 2)
  amount     Decimal  @db.Decimal(10, 2)
  approvedBy String   @map("approved_by") @db.VarChar(100)
  reason     String?  @db.Text
  createdAt  DateTime @default(now()) @map("created_at")

  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("discounts")
}

model TableSession {
  id        Int       @id @default(autoincrement())
  tableId   Int       @map("table_id")
  openedAt  DateTime  @default(now()) @map("opened_at")
  closedAt  DateTime? @map("closed_at")

  table     Table     @relation(fields: [tableId], references: [id], onDelete: Cascade)

  @@map("table_sessions")
}

// ==========================================
// ENTERPRISE SUBSCRIPTION MODELLING
// ==========================================

model Feature {
  id          Int           @id @default(autoincrement())
  code        String        @unique @db.VarChar(50)
  name        String        @db.VarChar(100)
  description String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")

  planFeatures PlanFeature[]
  addons       Addon[]

  @@map("features")
}

model SubscriptionPlan {
  id           Int           @id @default(autoincrement())
  name         String        @unique @db.VarChar(50)
  priceMonthly Decimal       @map("price_monthly") @db.Decimal(10, 2)
  priceYearly  Decimal       @map("price_yearly") @db.Decimal(10, 2)
  currency     String        @default("INR") @db.VarChar(10)
  
  maxTables    Int           @map("max_tables")
  maxStaff     Int           @map("max_staff")
  maxKds       Int           @map("max_kds")
  maxDailyOrders Int         @map("max_daily_orders") @default(30)
  
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  features     PlanFeature[]
  subscriptions RestaurantSubscription[]

  @@map("subscription_plans")
}

model PlanFeature {
  planId    Int              @map("plan_id")
  featureId Int              @map("feature_id")
  enabled   Boolean          @default(true)
  
  plan      SubscriptionPlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  feature   Feature          @relation(fields: [featureId], references: [id], onDelete: Cascade)

  @@id([planId, featureId])
  @@map("plan_features")
}

model RestaurantSubscription {
  id                Int                     @id @default(autoincrement())
  restaurantId      Int                     @unique @map("restaurant_id")
  planId            Int                     @map("plan_id")
  
  status            String                  @default("trialing") @db.VarChar(30)
  billingPeriod     String                  @default("monthly") @map("billing_period")
  
  startDate         DateTime                @default(now()) @map("start_date")
  endDate           DateTime                @map("end_date")
  
  trialStart        DateTime?               @map("trial_start")
  trialEnd          DateTime?               @map("trial_end")
  convertedAt       DateTime?               @map("converted_at")
  
  extraTablesCount  Int                     @default(0) @map("extra_tables_count")
  extraStaffCount   Int                     @default(0) @map("extra_staff_count")
  
  createdAt         DateTime                @default(now()) @map("created_at")
  updatedAt         DateTime                @updatedAt @map("updated_at")

  restaurant        Restaurant              @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan              SubscriptionPlan        @relation(fields: [planId], references: [id])
  paymentProfiles   PaymentProfile[]
  addons            SubscriptionAddon[]
  invoices          Invoice[]
  history           SubscriptionHistory[]

  @@map("restaurant_subscriptions")
}

model PaymentProfile {
  id             Int                    @id @default(autoincrement())
  subscriptionId Int                    @map("subscription_id")
  provider       String                 @db.VarChar(50)
  customerId     String                 @map("customer_id") @db.VarChar(150)
  externalSubId  String?                @map("external_sub_id") @db.VarChar(150)
  isActive       Boolean                @default(true) @map("is_active")
  createdAt      DateTime               @default(now()) @map("created_at")

  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@unique([provider, customerId])
  @@map("payment_profiles")
}

model Addon {
  id          Int                 @id @default(autoincrement())
  code        String              @unique @db.VarChar(50)
  name        String              @db.VarChar(100)
  price       Decimal             @db.Decimal(10, 2)
  unitType    String              @map("unit_type") @db.VarChar(20)
  featureId   Int?                @map("feature_id")
  
  feature     Feature?            @relation(fields: [featureId], references: [id], onDelete: SetNull)
  subscriptions SubscriptionAddon[]

  @@map("addons")
}

model SubscriptionAddon {
  id             Int                    @id @default(autoincrement())
  subscriptionId Int                    @map("subscription_id")
  addonId        Int                    @map("addon_id")
  quantity       Int                    @default(1)
  purchasedAt    DateTime               @default(now()) @map("purchased_at")

  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
  addon          Addon                  @relation(fields: [addonId], references: [id])

  @@map("subscription_addons")
}

model UsageMetric {
  id           Int        @id @default(autoincrement())
  restaurantId Int        @map("restaurant_id")
  metric       String     @db.VarChar(50)
  currentValue Int        @default(0) @map("current_value")
  period       String     @db.VarChar(20)
  lastSyncedAt DateTime   @default(now()) @map("last_synced_at")

  restaurant   Restaurant @relation(fields: [restaurantId], references: [id], onDelete: Cascade)

  @@unique([restaurantId, metric, period])
  @@map("usage_metrics")
}

model Coupon {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  discountPct Decimal  @map("discount_pct") @db.Decimal(5, 2)
  activeFrom  DateTime @map("active_from")
  activeUntil DateTime @map("active_until")
  maxUses     Int      @default(100) @map("max_uses")
  usedCount   Int      @default(0) @map("used_count")

  invoices    Invoice[]

  @@map("coupons")
}

model Invoice {
  id             Int                    @id @default(autoincrement())
  subscriptionId Int                    @map("subscription_id")
  invoiceNo      String                 @unique @map("invoice_no") @db.VarChar(50)
  subtotal       Decimal                @db.Decimal(10, 2)
  discount       Decimal                @default(0.00) @db.Decimal(10, 2)
  tax            Decimal                @db.Decimal(10, 2)
  total          Decimal                @db.Decimal(10, 2)
  status         String                 @default("unpaid") @db.VarChar(25)
  couponId       Int?                   @map("coupon_id")
  createdAt      DateTime               @default(now()) @map("created_at")
  paidAt         DateTime?              @map("paid_at")

  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id])
  coupon         Coupon?                @relation(fields: [couponId], references: [id])
  items          InvoiceItem[]

  @@map("invoices")
}

model InvoiceItem {
  id          Int     @id @default(autoincrement())
  invoiceId   Int     @map("invoice_id")
  description String  @db.VarChar(250)
  quantity    Int
  unitPrice   Decimal @map("unit_price") @db.Decimal(10, 2)
  totalAmount Decimal @map("total_amount") @db.Decimal(10, 2)

  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)

  @@map("invoice_items")
}

model SubscriptionHistory {
  id             Int                    @id @default(autoincrement())
  subscriptionId Int                    @map("subscription_id")
  oldPlanName    String                 @map("old_plan_name") @db.VarChar(50)
  newPlanName    String                 @map("new_plan_name") @db.VarChar(50)
  changedAt      DateTime               @default(now()) @map("changed_at")
  reason         String                 @db.Text
  invoiceId      Int?                   @map("invoice_id")

  subscription   RestaurantSubscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("subscription_histories")
}

// ==========================================
// SIMPLE & STRONG SAAS SUBSCRIPTION ENGINE (V1)
// ==========================================

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  GRACE
  SUSPENDED
  CANCELLED
}

model Plan {
  id              Int            @id @default(autoincrement())
  name            String         @unique @db.VarChar(50)
  price           Decimal        @db.Decimal(10, 2)
  billingDays     Int            @default(30) @map("billing_days")
  firstMonthPrice Decimal        @default(1.00) @map("first_month_price") @db.Decimal(10, 2)
  features        Json?
  isActive        Boolean        @default(true) @map("is_active")
  createdAt       DateTime       @default(now()) @map("created_at")
  updatedAt       DateTime       @updatedAt @map("updated_at")

  subscriptions   Subscription[]

  @@map("saas_plans")
}

model Subscription {
  id                 Int                    @id @default(autoincrement())
  restaurantId       Int                    @unique @map("restaurant_id")
  planId             Int                    @map("plan_id")
  status             SubscriptionStatus     @default(ACTIVE)
  startedAt          DateTime               @default(now()) @map("started_at")
  currentPeriodStart DateTime               @default(now()) @map("current_period_start")
  currentPeriodEnd   DateTime               @map("current_period_end")
  nextBillingAt      DateTime               @map("next_billing_at")
  amount             Decimal                @default(1.00) @db.Decimal(10, 2)
  renewalAmount      Decimal                @map("renewal_amount") @db.Decimal(10, 2)
  graceDays          Int                    @default(7) @map("grace_days")
  discountApplied    Decimal                @default(0.00) @map("discount_applied") @db.Decimal(10, 2)
  notes              String?                @db.Text
  createdAt          DateTime               @default(now()) @map("created_at")
  updatedAt          DateTime               @updatedAt @map("updated_at")

  restaurant         Restaurant             @relation(fields: [restaurantId], references: [id], onDelete: Cascade)
  plan               Plan                   @relation(fields: [planId], references: [id])
  payments           SaasPayment[]
  reminders          SubscriptionReminder[]
  events             SubscriptionEvent[]

  @@map("saas_subscriptions")
}

model SaasPayment {
  id             Int          @id @default(autoincrement())
  restaurantId   Int          @map("restaurant_id")
  subscriptionId Int          @map("subscription_id")
  amount         Decimal      @db.Decimal(10, 2)
  paymentMethod  String       @default("UPI") @map("payment_method") @db.VarChar(50)
  status         String       @default("SUCCESS") @db.VarChar(30)
  transactionId  String?      @unique @map("transaction_id") @db.VarChar(100)
  gateway        String?      @default("Cashfree") @db.VarChar(50)
  gatewayEventId String?      @unique @map("gateway_event_id") @db.VarChar(150)
  cfOrderId      String?      @map("cf_order_id") @db.VarChar(100)
  cfPaymentId    String?      @map("cf_payment_id") @db.VarChar(100)
  notes          String?      @db.Text
  paidAt         DateTime?    @default(now()) @map("paid_at")
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("saas_payments")
}

model SubscriptionReminder {
  id             Int          @id @default(autoincrement())
  subscriptionId Int          @map("subscription_id")
  type           String       @db.VarChar(30)
  scheduledAt    DateTime     @map("scheduled_at")
  sentAt         DateTime?    @map("sent_at")
  status         String       @default("PENDING") @db.VarChar(20)
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("saas_subscription_reminders")
}

model SubscriptionEvent {
  id             Int          @id @default(autoincrement())
  subscriptionId Int          @map("subscription_id")
  action         String       @db.VarChar(50)
  actor          String       @default("System") @db.VarChar(100)
  details        Json?
  notes          String?      @db.Text
  createdAt      DateTime     @default(now()) @map("created_at")

  subscription   Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("saas_subscription_events")
}
